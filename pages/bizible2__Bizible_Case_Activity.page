<apex:page sidebar="false" standardController="Case">
    <script type="text/javascript">
        function resizeIframe() {
            var frameHeight = window.innerHeight;
            var iframeElement = document.getElementById("BizibleCaseActivity");
            iframeElement.height = frameHeight;
        }
        function AttachDocumentReady(onDocumentReady) {
            var a = document;
            if(a.readyState == "complete" || (a.addEventListener && a.readyState == "loaded")) {
                onDocumentReady();
            } else {
                if(window.addEventListener) {
                    window.addEventListener("load", function () {
                        onDocumentReady();
                    }, true);
                } else {
                    if(window.attachEvent) {
                        window.attachEvent("onload", function () {
                            onDocumentReady();
                        });
                    }
                }
            }
        }
        AttachDocumentReady(resizeIframe);      
    </script>
</apex:page>