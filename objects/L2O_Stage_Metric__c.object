    <fields>
        <fullName>Agreement__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Agreement</label>
        <referenceTo>Apttus__APTS_Agreement__c</referenceTo>
        <relationshipLabel>Stage Metrics</relationshipLabel>
        <relationshipName>Stage_Metrics</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Business_Days__c</fullName>
        <externalId>false</externalId>
        <formula>FLOOR(Business_Hours__c/8) +

IF(MOD(Business_Hours__c/8, 1) &lt; 0.25, 0,

IF(MOD(Business_Hours__c/8, 1) &lt; 0.75, 0.5, 1))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Business Days</label>
        <precision>18</precision>
        <required>false</required>
        <scale>1</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Business_Hours__c</fullName>
        <defaultValue>0</defaultValue>
        <externalId>false</externalId>
        <label>Business Hours</label>
        <precision>18</precision>
        <required>false</required>
        <scale>3</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>L2O_Current_Days_in_Stage__c</fullName>
        <externalId>false</externalId>
        <formula>TODAY() - DATEVALUE(CreatedDate)</formula>
        <label>Current Days in Stage</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>L2O_Current_Stage_Date__c</fullName>
        <formula>CreatedDate</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>To Stage Date</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>L2O_From_Stage_Date__c</fullName>
        <label>From Stage Date</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>L2O_From_Stage__c</fullName>
        <label>From Stage</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>L2O_Opportunity_Stage</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>L2O_Number_of_Days__c</fullName>
        <externalId>false</externalId>
        <formula>CreatedDate - L2O_From_Stage_Date__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Duration(Days)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>L2O_Number_of_Hours__c</fullName>
        <externalId>false</externalId>
        <formula>(CreatedDate - L2O_From_Stage_Date__c)*24</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Duration(Hours)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>L2O_Opportunity__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Opportunity</label>
        <referenceTo>Opportunity</referenceTo>
        <relationshipLabel>Stage Metrics</relationshipLabel>
        <relationshipName>Stage_Metrics</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>L2O_Sequence_Number__c</fullName>
        <externalId>false</externalId>
        <label>Sequence Number</label>
        <precision>4</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>L2O_To_Stage__c</fullName>
        <label>To Stage</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>L2O_Opportunity_Stage</valueSetName>
        </valueSet>
    </fields>
    <label>Stage Metric</label>
    <nameField>
        <displayFormat>SM-{00000}</displayFormat>
        <label>Stage Metric Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Stage Metrics</pluralLabel>
