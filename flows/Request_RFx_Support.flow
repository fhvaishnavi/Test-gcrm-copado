    <decisions>
        <description>Check if the value in the Request Details field is entered.</description>
        <name>Check_Request_Details_value</name>
        <label>Check Request Details value</label>
        <locationX>314</locationX>
        <locationY>866</locationY>
        <defaultConnector>
            <targetReference>Assign_RFP_Values</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Value_Entered</defaultConnectorLabel>
        <rules>
            <name>No_Value</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>RFP_Record.Request_Details__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>RFP_Record.Response_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Other</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Required_Value</targetReference>
            </connector>
            <label>No_Value</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checking to determine which object the Request RFx button has been used from.</description>
        <name>Object_Decision</name>
        <label>Object Decision</label>
        <locationX>314</locationX>
        <locationY>350</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Account_Record</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <elementReference>AccountRecord</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetRecordType</targetReference>
            </connector>
            <label>Account</label>
        </rules>
        <rules>
            <name>Opportunity_Record</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <elementReference>OpportunityRecord</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetOpportunityRecordType</targetReference>
            </connector>
            <label>Opportunity</label>
        </rules>
    </decisions>
