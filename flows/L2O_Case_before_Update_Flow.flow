<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>55.0</apiVersion>
    <decisions>
        <name>Check_For_Bypass</name>
        <label>Check For Bypass</label>
        <locationX>182</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>No_Bypass</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Setup.BypassSetting__c.Bypass_Flow__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_case_Record</targetReference>
            </connector>
            <label>No Bypass</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>L2O_Case {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case before Update Flow</label>
    <processMetadataValues>
